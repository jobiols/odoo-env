class "TestGetManifest" as odoo_env.test_client.TestGetManifest {
  check_common_patcher : _patch
  check_v2_patcher : _patch
  config_data_patcher : _patch
  discover_patcher : _patch
  get_client_path_patcher : _patch
  mock_check_common : AsyncMock, MagicMock, dict
  mock_check_v2 : AsyncMock, MagicMock, dict
  mock_config_data : AsyncMock, MagicMock, dict
  mock_discover_manifest_from_path : AsyncMock, MagicMock, dict
