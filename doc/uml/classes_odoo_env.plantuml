@startuml classes_odoo_env
set namespaceSeparator none
class "BackupManager" as odoo_env.managers.backup_manager.BackupManager {
  client
  docker_client
  parent
  restore(database: 'str | bool | None', backup_file: 'str | bool | None', no_deactivate)
}
class "Client" as odoo_env.client.Client {
  backup_dir
  base_dir
  config
  config_file
  database_default_name
  debug
  external_dependencies
  images
  longpolling_port
  name
  numeric_ver
  port
  prod_server
  psql_dir
  repos
  server_backup_dir
  server_base_dir
  server_version_dir
  sources_dir
  version
  version_dir
  check_common(manifest)
  check_v2(manifest)
  get_image(value)
  get_image_required(value)
  get_manifest(path)
  get_manifest_from_struct(path: Path) -> tuple[dict[str, object] | None, str | None]
  get_manifest_from_url() -> dict[str, object] | None
  image(image_name)
  load_manifest(filename: 'str | Path') -> dict[str, object]
  parse_odoo_version(ver: str) -> str
}
class "CloneRepo" as odoo_env.command.CloneRepo {
  check_args()
}
class "Command" as odoo_env.command.Command {
  args
  command
  usr_msg
  check()
  check_args() -> bool
  execute()
  subprocess_call(cmd, check, capture)
}
class "CreateGitignore" as odoo_env.command.CreateGitignore {
  check_args()
  execute()
}
class "DockerClient" as odoo_env.services.docker_client.DockerClient {
  get_extract_cp_command(image: str, container_src: str, host_dest: str, mount: str) -> list[str]
  get_network_create_command(network: str) -> list[str]
  get_pull_command(image: str) -> list[str]
  get_rm_command(container_name: str) -> list[str]
  get_run_command(spec: RunSpec) -> list[str]
  get_stop_command(container_name: str) -> list[str]
}
