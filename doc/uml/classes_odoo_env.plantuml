class "MakedirCommand" as odoo_env.command.MakedirCommand {
  check_args()
}
class "MessageOnly" as odoo_env.command.MessageOnly {
  check_args()
  {abstract}execute()
}
class "MockArgs" as odoo_env.test_helpers.MockArgs {
}
class "Msg" as odoo_env.messages.Msg {
  done(text)
  err(text) -> NoReturn
  green(string)
  inf(text)
  red(string)
  run(text)
  warn(text)
  yellow(string)
  yellow_light(string)
}
class "OdooConf" as odoo_env.odoo_conf.OdooConf {
  config : dict
  add_line(line)
  add_list_data(datas)
  read_config()
  write_config()
}
class "OdooEnv" as odoo_env.odooenv.OdooEnv {
  client
  debug
  verbose
  build_commands()
  create_test_db()
  do_extract_sources()
  execute(commands)
  get_packs()
  install()
  pull_images()
  qa(modules_to_test)
  restore(client_name, database: 'str | bool | None', backup_file: 'str | bool | None', no_deactivate)
  run_client(write_config)
  run_environment()
  server_help()
  stop_client()
  stop_environment()
  update(database, modules)
  write_config()
}
class "OdooEnvTestCase" as odoo_env.test_helpers.OdooEnvTestCase {
  config_data_patcher : _patch
  maxDiff : NoneType
  mock_config_data : AsyncMock, MagicMock, dict
  mock_get_manifest : AsyncMock, MagicMock, dict
  mock_save_config : AsyncMock, MagicMock, dict
  patcher : _patch
  save_config_patcher : _patch
  setUp()
  tearDown()
}
