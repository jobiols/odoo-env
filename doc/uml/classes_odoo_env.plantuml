  mock_get_manifest_from_struct : AsyncMock, MagicMock, dict
  mock_save_client_path : AsyncMock, MagicMock, dict
  mock_save_config : AsyncMock, MagicMock, dict
  mock_subprocess_run : AsyncMock, MagicMock, dict
  save_client_path_patcher : _patch
  save_config_patcher : _patch
  struct_patcher : _patch
  subprocess_patcher : _patch
  setUp()
  tearDown()
  test_empty_url_raises_oe_error()
  test_existing_client_path_skips_url_bool()
  test_existing_client_path_skips_url_str()
  test_install_bool_skips_url()
