class "RunSpec" as odoo_env.services.docker_client.RunSpec {
  cmd : str | list[str] | None
  database : str | None
  detach : bool
  entrypoint : str | None
  env : dict[str, str] | None
  extra_args : list[str] | None
  image : str
  interactive : bool
  links : dict[str, str] | None
  log_level : str | None
  logfile : str | None
  name : str | None
  network : str | None
  ports : dict[int, int] | None
  remove : bool
  restart : str | None
  stop_after_init : bool
  test_enable : bool
  user : str | None
  volumes : Mapping[str, dict[str, str] | str] | None
  workdir : str | None
}
